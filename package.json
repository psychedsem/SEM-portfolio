{
  "name": "sem-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio personale realizzato con HTML, Bootstrap e Sass.",
  "scripts": {
    "sass": "sass --watch scss/main.scss css/main.css",
    "build": "sass --style=expanded --no-source-map scss/main.scss css/main.css",
    "build:min": "sass --style=compressed --no-source-map scss/main.scss css/main.min.css"
  },
  "devDependencies": {
    "sass": "^1.101.7"
  }
}
